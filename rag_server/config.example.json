{
  "embedding": {
    "model": "BAAI/bge-small-zh-v1.5",
    "cache_dir": "",
    "device": "auto",
    "dtype": "auto",
    "gpu_id": 0
  },
  "llm_profiles": {
    "self_hosted_glm": {
      "provider": "openai",
      "model": "你的本地模型名或路径",
      "base_url": "http://你的GLM服务地址:端口/v1",
      "api_key": "dummy",
      "endpoint": "chat",
      "max_tokens": 2048,
      "timeout": 120,
      "max_retries": 3,
      "retry_backoff": 2.0,
      "context_window": 80000,
      "concurrency": 2
    },
    "bedrock_glm_flash": {
      "provider": "bedrock",
      "model": "zai.glm-4.7-flash",
      "region": "us-east-1",
      "api_key_env": "AWS_BEARER_TOKEN_BEDROCK",
      "max_tokens": 2048,
      "timeout": 120,
      "max_retries": 3,
      "retry_backoff": 2.0,
      "context_window": 8192,
      "concurrency": 1
    },
    "bedrock_kimi_thinking": {
      "provider": "bedrock",
      "model": "moonshot.kimi-k2-thinking",
      "region": "us-east-1",
      "api_key_env": "AWS_BEARER_TOKEN_BEDROCK",
      "max_tokens": 4096,
      "timeout": 180,
      "max_retries": 2,
      "retry_backoff": 3.0,
      "context_window": 128000,
      "concurrency": 1
    },
    "deepseek": {
      "provider": "openai",
      "model": "deepseek-chat",
      "base_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY",
      "endpoint": "chat",
      "max_tokens": 4096,
      "timeout": 120,
      "max_retries": 3,
      "retry_backoff": 2.0,
      "context_window": 64000,
      "concurrency": 4
    }
  },
  "llm_routing": {
    "qa": "bedrock_glm_flash",
    "pre_review": "bedrock_glm_flash",
    "conflict_detection": "bedrock_glm_flash",
    "parse_qa": "bedrock_glm_flash"
  },
  "retrieval": {
    "top_k": 15,
    "similarity_threshold": 0.5,
    "context_radius": 2
  },
  "pre_review": {
    "similarity_threshold": 0.8,
    "version_similarity_threshold": 0.9,
    "batch_size": 0,
    "parse_backend": "auto",
    "docling_device": "auto",
    "docling_batch_size": 0,
    "noise_filter": {
      "enabled": true,
      "patterns": [
        "修订日期\\s*[：:]\\s*\\S+",
        "(?:^\\s*|\\b)\\d{4}[-./]\\s*\\d{1,2}[-./]\\s*\\d{1,2}\\s*(?:$|\\b)",
        "(?:R\\d+-\\d{2,}|BK-J-\\d+|版次\\s*[：:]\\s*\\S+)"
      ]
    }
  },
  "judge": {
    "prompt_file": "",
    "prompt_template": ""
  },
  "conflict_detection": {
    "min_score": 0.7,
    "min_similarity": 0.5,
    "max_similarity": 0.95
  },
  "prompts": {
    "system": "你是一个企业文档问答助手。根据提供的参考资料回答用户问题。\n要求：\n1. 先直接回答用户问题，再补充必要的解释；仅基于参考资料，不要编造信息\n2. 先综合所有相关资料，再组织成一份连贯、去重的答案；不要把每个参考片段逐条改写成列表。相同事实只表达一次，可在结论末尾合并多个引用编号；流程、方法、规范类问题按资料明确的先后顺序或逻辑阶段整理，不要自行补造顺序；资料有明确条款或方法时，不要只回答章节标题或转述“见某表/某程序”\n3. 参考资料已以 [1] 文件名 | 位置\\n段落内容 的形式给出，编号 [1] / [2] 对应底部来源编号 B1 / B2\n4. 如果参考资料中有矛盾描述，必须醒目指出\n5. 如果参考资料不足以回答，明确告知用户\n6. 对于关于知识库本身的元数据问题（如共几篇文档），根据参考资料的来源信息如实回答",
    "context_template": "[{idx}] {source} | {location}\n{text}\n",
    "conflict_warning": "\n⚠️ 注意：以下文档对此问题的描述存在矛盾：\n{conflicts}\n请以最新版本或上级文档为准。"
  },
  "chat": {
    "max_history": 20
  },
  "parse_cleanup": {
    "enabled": false,
    "llm_profile": "pre_review"
  },
  "parse_qa": {
    "enabled": false,
    "llm_profile": "pre_review",
    "max_candidates": 20,
    "batch_size": 10,
    "max_retries": 2,
    "retry_backoff": 1.0
  }
}